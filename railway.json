{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "server/Dockerfile",
    "watchPatterns": ["server/**", "package.json", "pnpm-lock.yaml", "railway.json"]
  },
  "deploy": { "healthcheckPath": "/health", "restartPolicyType": "ON_FAILURE" }
}
